# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Supabase ---
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server-only. Bypasses RLS — never expose to the client or commit.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
VITE_SUPABASE_PROJECT_ID="<project>"
VITE_SUPABASE_URL="https://<project>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- AI (Google Gemini by default) ---
# Key from https://aistudio.google.com/apikey
AI_API_KEY=""
# Optional overrides. AI_BASE_URL accepts any OpenAI-compatible endpoint.
# AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# AI_NATIVE_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
# AI_TEXT_MODEL="gemini-3-flash-preview"
# AI_IMAGE_MODEL="gemini-3.1-flash-image"

# --- Sessions ---
# Must be at least 32 characters. Generate: openssl rand -hex 32
SESSION_SECRET=""

# --- LinkedIn OAuth (https://www.linkedin.com/developers/apps) ---
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="https://<your-domain>/api/public/linkedin/callback"

# --- Drizzle migrations only (direct Postgres connection string) ---
DB_MIGRATION_URL=""
